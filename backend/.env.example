# 主库配置（租户元数据）
MASTER_DB_HOST=localhost
MASTER_DB_PORT=3306
MASTER_DB_USER=root
MASTER_DB_PASSWORD=root
MASTER_DB_NAME=lowcode_master

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT
SECRET_KEY=change-this-to-a-32-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 应用
APP_ENV=development
APP_PORT=8000

# LLM（例句翻译 / AI 学习日报 / 每日一读 用；留空则走内置降级模板）
# DeepSeek 示例：
#   LLM_API_KEY=sk-xxx
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 通义千问（DashScope 兼容模式）示例：
#   LLM_API_KEY=sk-xxx
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# 文心一言 示例：
#   LLM_API_KEY=xxx
#   LLM_BASE_URL=https://qianfan.baidubce.com/v2
#   LLM_MODEL=ernie-4.0-8k
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_PROVIDER_TYPE=custom
